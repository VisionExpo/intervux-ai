# =========================
# Intervux AI Environment
# =========================

# Database
DATABASE_URL=postgresql://intervux:change_me@localhost:5432/intervux
POSTGRES_USER=intervux
POSTGRES_PASSWORD=change_me
POSTGRES_DB=intervux
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_BROKER_MAX_RETRIES=-1
CELERY_VISIBILITY_TIMEOUT_S=7200
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_RESULT_EXPIRES_S=3600
CELERY_TASK_IGNORE_RESULT=true

# Auth
JWT_SECRET_KEY=replace_with_strong_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=12
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Runtime
RUNTIME_THREADPOOL_WORKERS=4
MAX_CONCURRENT_SESSIONS=5
MAX_QUESTIONS_HARD_CAP=8
RATE_LIMIT_WS_PER_MINUTE=30
RATE_LIMIT_WS_MAX_TRACKED_IPS=10000
RATE_LIMIT_WS_PRUNE_INTERVAL_S=30
WS_RECEIVE_TIMEOUT_S=120
WS_SEND_TIMEOUT_S=20
DISABLE_STT=false
METRICS_LATENCY_MAX_SAMPLES=5000

# AI Providers
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=qwen
LLM_AUTO_FALLBACK=true
LLM_FALLBACK_ON_ANY_ERROR=false
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_TIMEOUT_S=120

# LLM Circuit Breaker
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CB_FAILURE_THRESHOLD=3
LLM_CB_SLOW_THRESHOLD_S=12
LLM_CB_SLOW_STRIKES_THRESHOLD=3
LLM_CB_OPEN_SECONDS=60
EVAL_MULTI_PASS=true
EVAL_SELF_CONSISTENCY=true

# TTS / Audio cleanup
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-JennyNeural
TTS_STATIC_TTL_SECONDS=3600
TTS_STATIC_MAX_FILES=500

# Alerting
ALERT_NOTIFY_WORKERS=4
ALERT_NOTIFY_MAX_PENDING=100
ALERT_COOLDOWN_SECONDS=300
