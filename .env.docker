# Docker Environment Variables
# Use 'postgres' as host since it's the service name in Docker network

# Database Configuration
DATABASE_URL=postgresql://intervux:change_me@postgres:5432/intervux

# Postgres container credentials
POSTGRES_USER=intervux
POSTGRES_PASSWORD=change_me
POSTGRES_DB=intervux

# Redis / Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT Configuration
JWT_SECRET_KEY=intervux-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=12
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Runtime Configuration
RUNTIME_THREADPOOL_WORKERS=4
MAX_CONCURRENT_SESSIONS=5
RATE_LIMIT_WS_PER_MINUTE=30
WS_RECEIVE_TIMEOUT_S=120
WS_SEND_TIMEOUT_S=20
DISABLE_STT=false
EDGE_TTS_VOICE=en-US-AriaNeural

