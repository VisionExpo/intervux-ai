# Database Configuration
DATABASE_URL=
POSTGRES_USER=intervux
POSTGRES_PASSWORD=
POSTGRES_DB=intervux

# Redis / Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT Configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=12
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo accounts (admin@intervux.ai / recruiter@intervux.ai). Off by default and
# never enabled when ENV=production. Set both a flag and a password to use them.
ENABLE_DEMO_USERS=false
DEMO_ADMIN_PASS=
DEMO_RECRUITER_PASS=
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Runtime Configuration
RUNTIME_THREADPOOL_WORKERS=24
MAX_CONCURRENT_SESSIONS=5
RATE_LIMIT_WS_PER_MINUTE=30
WS_RECEIVE_TIMEOUT_S=120
WS_SEND_TIMEOUT_S=20
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=qwen
LLM_AUTO_FALLBACK=true
LLM_FALLBACK_ON_ANY_ERROR=false
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_TIMEOUT_S=120
DISABLE_STT=false
EDGE_TTS_VOICE=en-US-AriaNeural
SELF_CONSISTENCY_PASSES=1
GOOGLE_API_KEY=

# Optional
FLOWER_BASIC_AUTH=
